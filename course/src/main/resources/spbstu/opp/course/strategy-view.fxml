<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="spbstu.opp.course.stratagy.StrategyController"
    spacing="12" alignment="TOP_LEFT" prefWidth="700" prefHeight="480" style="-fx-padding:16;">

    <Label prefHeight="20" fx:id="heroNameText" text="Hero: Alex"/>
    <Label prefHeight="20" fx:id="currentLocationText" text="Current Location: Home"/>

    <HBox spacing="10" prefHeight="20">
        <Label text="Target Location:"/>
        <TextField fx:id="targetLocationField" prefWidth="180"/>
    </HBox>

    <HBox spacing="4" prefHeight="20">
        <Label text="Movement mode:"/>
        <ComboBox fx:id="movementModeComboBox" prefWidth="180" onAction="#onMovementChanged"/>
    </HBox>

    <HBox spacing="10" prefHeight="20">
        <Button prefWidth="80" text="Go!" onAction="#onGo"/>
        <Button text="Clear" onAction="#onClear" />
    </HBox>

    <Label text="Log:"/>
    <TextArea fx:id="logArea" editable="false" prefRowCount="12" VBox.vgrow="ALWAYS"/>
</VBox>